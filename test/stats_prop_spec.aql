# Property-based tests for stats — DECLARATIVE SPEC FORMAT.
#
# This file exercises boru:test's declarative property surface:
# `Test.prop` builds a `PropertySpec` as *data* —
#
#   Test.prop NAME [GEN-BODY] [PROPERTY-BODY]   →   PropertySpec map
#
# — which `Test.run-property` runs (at the default 100 iterations).
#
# The sibling `test/stats_prop_test.aql` covers the SAME idea through the
# imperative `Test.check-prop` driver. Stats words are called verb-first
# (`Stats.verb data args… end`).
#
# GEN-BODY runs with `r` (a seeded boru:rand instance) in scope and must
# leave one value on the stack. PROPERTY-BODY takes that value and must
# return a Boolean.
#
# Run:
#   aql test/stats_prop_spec.aql


# The library under test is imported FIRST, before `boru:test`: works
# around a boru runtime defect (a type-ID collision between boru:test's
# record types and a user module's `class` when boru:test is imported
# first — every Summary-returning word then raised `type_error: …
# expected Summary, got Summary`). Remove the ordering constraint when
# fixed upstream; see dx-report.md "Migration to boru main @ 64c5ab2".
import "../stats.aql" end
import "boru:test" end
import "boru:math-util" end
import "boru:array-util" end


# --- reporting helper ----------------------------------------------

def report fn [
  [res:Map] [] [
    def ok (res "ok" get)
    def nm (res "name" get)
    def msg (if ok
      [`ok   ${nm} (${(res "runs" get)} runs)`]
      [`FAIL ${nm}  failing-input: ${(res "failing-input" get)}`])
    msg print
  ]
]


# --- the spec suite, built as data ---------------------------------

def specs [

  # 1. The mean lies within [min, max].
  (Test.prop "mean-within-range"
    [ r.list-of [r.int 0 100] 8 ]
    [ var [[xs]
        def mu (Stats.mean xs end)
        ((Stats.min xs end) lte mu) and (mu lte (Stats.max xs end))
    ]])

  # 2. Population variance is non-negative.
  (Test.prop "pvariance-non-negative"
    [ r.list-of [r.int 0 100] 8 ]
    [ var [[xs] (Stats.pvariance xs end) gte 0.0 ]])

  # 3. The median lies within [min, max].
  (Test.prop "median-within-range"
    [ r.list-of [r.int 0 100] 8 ]
    [ var [[xs]
        def md (Stats.median xs end)
        ((Stats.min xs end) lte md) and (md lte (Stats.max xs end))
    ]])

  # 4. range == max - min, and is non-negative.
  (Test.prop "range-is-max-minus-min"
    [ r.list-of [r.int 0 100] 8 ]
    [ var [[xs]
        def rg (Stats.range xs end)
        (rg gte 0.0) and (rg eq ((Stats.max xs end) sub (Stats.min xs end)))
    ]])

  # 5. The mode is a member of the data.
  (Test.prop "mode-is-a-member"
    [ r.list-of [r.int 0 100] 8 ]
    [ var [[xs]
        def md (Stats.mode xs end)
        def fs (xs each [var [[x] (convert Float x)]])
        (ArrayUtil.member [md] fs) get 0
    ]])

  # 6. count equals the input length.
  (Test.prop "count-equals-length"
    [ r.list-of [r.int 0 100] 8 ]
    [ var [[xs] (Stats.count xs end) eq (xs size) ]])

]


# --- run every spec ------------------------------------------------

def _ (specs each [
  var [[s]
    (s Test.run-property) report
    0
  ]
])


# --- summary -------------------------------------------------------

# One `print (value)` per statement: `print` collects a FORWARD argument
# and a line break is not a barrier, so the older `"---" print` /
# `"x" print` chain printed out of order on boru main.
print ("---")
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print ("all green")
