# stats direct unit tests using boru:test's imperative API.
#
# The sibling file `test/stats_unit_spec.aql` covers the same kind of
# example-based checks through the declarative spec surface
# (`Test.run-spec`). Exact-valued statistics are asserted with
# `Assert.equal`; the irrational ones (stddev, correlation, the normal
# distribution) are checked within a tolerance via the `close` helper.
#
# Stats words are called verb-first (`Stats.verb data args… end`).
#
# Run:
#   aql test/stats_unit_test.aql


# The library under test is imported FIRST, before `boru:test`: works
# around a boru runtime defect (a type-ID collision between boru:test's
# record types and a user module's `class` when boru:test is imported
# first — every Summary-returning word then raised `type_error: …
# expected Summary, got Summary`). Remove the ordering constraint when
# fixed upstream; see dx-report.md "Migration to boru main @ 64c5ab2".
import "../stats.aql" end
import "boru:test" end
import "boru:math-util" end
import "boru:matrix-util" end


# Float tolerance: |a - b| < 1e-9. `a` is the actual value, `b` expected.
def close fn [
  [a:Float b:Float] [Boolean] [
    (MathUtil.abs (a sub b)) lt 0.000000001
  ]
]

# Looser tolerance (1e-5) for the erf-approximation-backed normal CDF.
def near fn [
  [a:Float b:Float] [Boolean] [
    (MathUtil.abs (a sub b)) lt 0.00001
  ]
]


# --- central tendency & dispersion (exact) -------------------------

[
  def xs [1 2 3 4 5]
  3.0  (Stats.mean xs end)      Assert.equal end
  2.0  (Stats.pvariance xs end) Assert.equal end
  2.5  (Stats.variance xs end)  Assert.equal end
  15.0 (Stats.sum xs end)       Assert.equal end
  5    (Stats.count xs end)     Assert.equal end
  1.0  (Stats.min xs end)       Assert.equal end
  5.0  (Stats.max xs end)       Assert.equal end
  4.0  (Stats.range xs end)     Assert.equal end
] "central-tendency" Test.test end


# --- standard deviation (within tolerance) -------------------------

[
  def b [2 4 4 4 5 5 7 9]
  true ((Stats.pvariance b end) close 4.0) Assert.ok end
  true ((Stats.pstddev b end) close 2.0) Assert.ok end
  true ((Stats.stddev b end) close 2.138089935299395) Assert.ok end
] "stddev" Test.test end


# --- order statistics (exact) --------------------------------------

[
  def b [2 4 4 4 5 5 7 9]
  4.5 (Stats.median b end)        Assert.equal end
  4.0 (Stats.quantile b 0.25 end) Assert.equal end
  5.5 (Stats.quantile b 0.75 end) Assert.equal end
  1.5 (Stats.iqr b end)           Assert.equal end
  4.0 (Stats.mode b end)          Assert.equal end
] "order-statistics" Test.test end


# --- shape: skewness & kurtosis (within tolerance) -----------------

[
  def b [2 4 4 4 5 5 7 9]
  true ((Stats.skewness b end) close 0.65625)  Assert.ok end
  true ((Stats.kurtosis b end) close -0.21875) Assert.ok end
] "shape" Test.test end


# --- bivariate -----------------------------------------------------

[
  def x [1 2 3 4 5]
  def y [2 4 5 4 5]
  1.5 (Stats.covariance x y end)  Assert.equal end
  1.2 (Stats.pcovariance x y end) Assert.equal end
  true ((Stats.correlation x y end) close 0.7745966692414834) Assert.ok end
] "bivariate" Test.test end


# --- simple linear regression --------------------------------------

[
  def x [1 2 3 4 5]
  def y [2 4 5 4 5]
  def lr (Stats.linreg x y end)
  true ((lr.slope)     close 0.6) Assert.ok end
  true ((lr.intercept) close 2.2) Assert.ok end
  true ((lr.r2)        close 0.6) Assert.ok end
] "linreg" Test.test end


# --- distributions / scores ----------------------------------------

[
  true ((Stats.normal-pdf 1 {mu: 0.0, sigma: 1.0} end) close 0.24197072451914337) Assert.ok end
  true ((Stats.normal-cdf 0 {mu: 0.0, sigma: 1.0} end) near 0.5)    Assert.ok end
  true ((Stats.normal-cdf 1.96 {mu: 0.0, sigma: 1.0} end) near 0.9750021048517796) Assert.ok end
  def z (Stats.zscores [1 2 3] end)
  true ((z get 0) close -1.0) Assert.ok end
  true ((z get 1) close 0.0)  Assert.ok end
  true ((z get 2) close 1.0)  Assert.ok end
] "distributions" Test.test end


# --- accumulator: build / push / merge -----------------------------

[
  def s (Stats.summary [] end)
  def _ (Stats.push-all [1 2 3 4] s end)
  4   (Stats.count s end) Assert.equal end
  2.5 (Stats.mean s end)  Assert.equal end
  def _2 (Stats.push 5 s end)
  5   (Stats.count s end) Assert.equal end
  3.0 (Stats.mean s end)  Assert.equal end
] "accumulator" Test.test end


# --- receiver-last convention: forward and piping bind identically -
# push/push-all/merge take the accumulator as their LAST param, so the
# forward form (value first) and the piping form (accumulator from the
# left) must agree. This locks the convention against a silent reflip.

[
  def sp (Stats.summary [] end)
  def _p (sp Stats.push-all [1 2 3 4] end)   # piping: accumulator from left
  def _p2 (sp Stats.push 5 end)
  5   (Stats.count sp end) Assert.equal end
  3.0 (Stats.mean sp end)  Assert.equal end
  def ap (Stats.summary [1 2 3 4] end)
  def bp (Stats.summary [5 6 7 8] end)
  def mp (ap Stats.merge bp end)             # piping: receiver a from left
  8   (Stats.count mp end) Assert.equal end
  4.5 (Stats.mean mp end)  Assert.equal end
] "accumulator-receiver-last-piping" Test.test end


[
  def a (Stats.summary [1 2 3 4] end)
  def b (Stats.summary [5 6 7 8] end)
  def m (Stats.merge b a end)
  8   (Stats.count m end)    Assert.equal end
  4.5 (Stats.mean m end)     Assert.equal end
  6.0 (Stats.variance m end) Assert.equal end
] "merge-moments" Test.test end


# --- encode / decode round-trip ------------------------------------

[
  def s (Stats.summary [1 2 3 4 5 6 7 8] end)
  def back (Stats.decode (Stats.encode s end) end)
  (Stats.mean s end)     (Stats.mean back end)     Assert.equal end
  (Stats.variance s end) (Stats.variance back end) Assert.equal end
  (Stats.count s end)    (Stats.count back end)    Assert.equal end
] "encode-decode" Test.test end


# --- matrix / dataset words ----------------------------------------

[
  def mat (MatrixUtil.create [[1 1] [2 2] [3 3]])
  def means (Stats.col-means mat end)
  2.0 (means get 0) Assert.equal end
  2.0 (means get 1) Assert.equal end
  def cov (Stats.cov-matrix mat end)
  1.0 (cov MatrixUtil.elem 0 0) Assert.equal end
  1.0 (cov MatrixUtil.elem 1 0) Assert.equal end
] "dataset" Test.test end


# --- ordinary least squares ----------------------------------------

[
  # design = [1, x]; the fit recovers intercept -0.5 and slope 2.0.
  def design (MatrixUtil.create [[1 1] [1 2] [1 3] [1 4]])
  def coef (Stats.ols design [2 3 5 8] end)
  true ((coef get 0) close -0.5) Assert.ok end
  true ((coef get 1) close 2.0)  Assert.ok end
] "ols" Test.test end


# --- error codes ---------------------------------------------------

[
  bad_input/q  ((do [Stats.mean [] end]).code) Assert.equal end
  bad_input/q  ((do [Stats.variance [5] end]).code) Assert.equal end
  bad_input/q  ((do [Stats.quantile [1 2 3] 1.5 end]).code) Assert.equal end
  bad_input/q  ((do [Stats.covariance [1 2 3] [1 2] end]).code) Assert.equal end
  needs_data/q ((do [Stats.median (Stats.summary [1 2 3] end) end]).code) Assert.equal end
  bad_payload/q ((do [Stats.decode "not a snapshot {" end]).code) Assert.equal end
] "error-codes" Test.test end


[
  def design (MatrixUtil.create [[1 1] [1 1] [1 1]])
  singular/q ((do [Stats.ols design [1 2 3] end]).code) Assert.equal end
] "ols-singular" Test.test end


# --- summary -------------------------------------------------------

# One `print (value)` per statement: `print` collects a FORWARD argument
# and a line break is not a barrier, so the older `"---" print` /
# `"x" print` chain printed out of order on boru main.
print ("---")
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print ("all green")
