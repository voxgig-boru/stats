# Property-based tests for stats — DIRECT-CODE FORM.
#
# This file exercises one of boru:test's two property-test surfaces: the
# imperative `Test.check-prop` driver, called directly with explicit
# run / seed / shrink counts —
#
#   Test.check-prop NAME  [GEN-BODY]  [PROP-BODY]  RUNS  SEED  MAX-SHRINKS
#
# The sibling `test/stats_prop_spec.aql` covers the SAME idea through the
# declarative `PropertySpec` surface. Stats words are called verb-first
# (`Stats.verb data args… end`).
#
# GEN-BODY runs with `r` bound to the random source and must leave one
# value on the stack. PROP-BODY takes that value and returns a Boolean.
#
# Run:
#   aql test/stats_prop_test.aql


# The library under test is imported FIRST, before `boru:test`: works
# around a boru runtime defect (a type-ID collision between boru:test's
# record types and a user module's `class` when boru:test is imported
# first — every Summary-returning word then raised `type_error: …
# expected Summary, got Summary`). Remove the ordering constraint when
# fixed upstream; see dx-report.md "Migration to boru main @ 64c5ab2".
import "../stats.aql" end
import "boru:test" end
import "boru:math-util" end
import "boru:array-util" end


# |a - b| < 1e-6.
def close fn [
  [a:Float b:Float] [Boolean] [
    (MathUtil.abs (a sub b)) lt 0.000001
  ]
]


# --- P1. sample variance dominates population variance -------------
#
# variance = m2/(n-1) >= m2/n = pvariance, with equality only for
# constant data. Both are non-negative.

Test.check-prop "sample-var-ge-pop-var"
  [ r.list-of [r.int 0 100] 8 ]
  [ var [[xs]
      def sv (Stats.variance xs end)
      def pv (Stats.pvariance xs end)
      (pv gte 0.0) and (sv gte pv)
  ]]
  40 1 0
end drop   # check-prop returns its PropertyResult map; Test.results reads them all below


# --- P2. merge is consistent with pooling --------------------------
#
# Merging two summaries gives the same count and mean as summarising the
# concatenated data.

Test.check-prop "merge-pools-correctly"
  [ r.list-of [r.int 0 100] 6 ]
  [ var [[xs]
      def ys [10 20 30 40]
      def a (Stats.summary xs end)
      def b (Stats.summary ys end)
      def na (Stats.count a end)
      def merged (Stats.merge b a end)
      # Pool independently by pushing both lists into one summary.
      def pooled (Stats.summary xs end)
      def _p (Stats.push-all ys pooled end)
      ((Stats.count merged end) eq (na add 4))
        and ((Stats.mean merged end) close (Stats.mean pooled end))
  ]]
  30 1 0
end drop   # check-prop returns its PropertyResult map; Test.results reads them all below


# --- P3. correlation of a variable with itself is 1 ----------------
#
# (Degenerate constant data has zero variance and no defined
# correlation, so it is skipped — the property holds vacuously.)

Test.check-prop "self-correlation-is-one"
  [ r.list-of [r.int 0 100] 8 ]
  [ var [[xs]
      def v (Stats.variance xs end)
      if (v gt 0.0) [
        (Stats.correlation xs xs end) close 1.0
      ] [true]
  ]]
  40 1 0
end drop   # check-prop returns its PropertyResult map; Test.results reads them all below


# --- P4. z-scores are centered at zero -----------------------------

Test.check-prop "zscores-mean-zero"
  [ r.list-of [r.int 0 100] 8 ]
  [ var [[xs]
      def v (Stats.variance xs end)
      if (v gt 0.0) [
        (Stats.mean (Stats.zscores xs end) end) close 0.0
      ] [true]
  ]]
  40 1 0
end drop   # check-prop returns its PropertyResult map; Test.results reads them all below


# --- P5. encode / decode preserves count and mean ------------------

Test.check-prop "encode-decode-round-trips"
  [ r.list-of [r.int 0 100] 8 ]
  [ var [[xs]
      def s (Stats.summary xs end)
      def back (Stats.decode (Stats.encode s end) end)
      ((Stats.count s end) eq (Stats.count back end))
        and ((Stats.mean s end) close (Stats.mean back end))
  ]]
  30 1 0
end drop   # check-prop returns its PropertyResult map; Test.results reads them all below


# --- summary -------------------------------------------------------

print ("---")
print ("results:")
def _print-results ((Test.results end) each [
  var [[r]
    def nm (r "name" get)
    def ok (r "ok" get)
    if ok [`  pass: ${nm}` print] [`  FAIL: ${nm}  failing-input=${r "failing-input" get}` print]
    0
  ]
])
print ("---")
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print ("all green")
