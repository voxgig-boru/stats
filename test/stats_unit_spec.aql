# Example-based unit tests for stats — DECLARATIVE SPEC FORMAT.
#
# This file is the spec-format sibling of `test/stats_unit_test.aql`.
# Where that file drives example checks imperatively (`Test.test` with
# `Assert.equal`), this one expresses them as *data*: a list of
# `TestSpec` values that `Test.run-spec` walks and dispatches.
#
# A TestSpec is `{name, subject, cases, subs}`:
#   - `subject` is the exported word to exercise, named as a dotted
#     String (e.g. "Stats.mean").
#   - each case is `{name, in, out}`. `Test.run-spec` spreads `in` onto
#     the stack with `in[0]` as the dispatch subject (the receiver), then
#     deep-compares the result against `out`. So for a multi-argument
#     word the `in` list reads receiver-first — e.g. for `Stats.quantile`
#     (called `Stats.quantile xs q`) the case is `in: [q xs]`.
#
# Only exact-valued statistics live here (means over evenly-divisible
# data, population variance, the order statistics, exact covariance);
# the irrational results are tolerance-checked in the imperative sibling.
#
# Run:
#   boru test/stats_unit_spec.aql


# The library under test is imported FIRST, before `boru:test`: works
# around a boru runtime defect (a type-ID collision between boru:test's
# record types and a user module's `class` when boru:test is imported
# first — every Summary-returning word then raised `type_error: …
# expected Summary, got Summary`). Remove the ordering constraint when
# fixed upstream; see dx-report.md "Migration to boru main @ 64c5ab2".
import "../stats.aql" end
import "boru:test" end


def specs [

  # mean over evenly-divisible data is exact.
  {
    name:    "mean"
    subject: "Stats.mean"
    cases: [
      { name: "1-5"      in: [ [1 2 3 4 5] ]    out: 3.0 }
      { name: "constant" in: [ [7 7 7 7] ]      out: 7.0 }
    ]
    subs: []
  }

  # population variance and the trivial aggregates are exact.
  {
    name:    "pvariance"
    subject: "Stats.pvariance"
    cases: [
      { name: "1-5"      in: [ [1 2 3 4 5] ]  out: 2.0 }
      { name: "constant" in: [ [4 4 4 4] ]    out: 0.0 }
    ]
    subs: []
  }

  {
    name:    "sum"
    subject: "Stats.sum"
    cases: [ { name: "1-5" in: [ [1 2 3 4 5] ] out: 15.0 } ]
    subs: []
  }

  {
    name:    "count"
    subject: "Stats.count"
    cases: [
      { name: "five"  in: [ [1 2 3 4 5] ] out: 5 }
      { name: "empty" in: [ [] ]          out: 0 }
    ]
    subs: []
  }

  {
    name:    "range"
    subject: "Stats.range"
    cases: [ { name: "1-5" in: [ [1 2 3 4 5] ] out: 4.0 } ]
    subs: []
  }

  # order statistics.
  {
    name:    "median"
    subject: "Stats.median"
    cases: [
      { name: "odd"  in: [ [1 2 3 4 5] ]        out: 3.0 }
      { name: "even" in: [ [2 4 4 4 5 5 7 9] ]  out: 4.5 }
    ]
    subs: []
  }

  # `Stats.quantile xs q` — receiver-first `in`, so the case is [q xs].
  {
    name:    "quantile"
    subject: "Stats.quantile"
    cases: [
      { name: "q25" in: [ 0.25 [2 4 4 4 5 5 7 9] ] out: 4.0 }
      { name: "q75" in: [ 0.75 [2 4 4 4 5 5 7 9] ] out: 5.5 }
    ]
    subs: []
  }

  {
    name:    "iqr"
    subject: "Stats.iqr"
    cases: [ { name: "2-9" in: [ [2 4 4 4 5 5 7 9] ] out: 1.5 } ]
    subs: []
  }

  {
    name:    "mode"
    subject: "Stats.mode"
    cases: [ { name: "4-wins" in: [ [2 4 4 4 5 5 7 9] ] out: 4.0 } ]
    subs: []
  }

  # exact bivariate covariance (symmetric, so argument order is moot).
  {
    name:    "covariance"
    subject: "Stats.covariance"
    cases: [ { name: "sample" in: [ [1 2 3 4 5] [2 4 5 4 5] ] out: 1.5 } ]
    subs: []
  }

  {
    name:    "pcovariance"
    subject: "Stats.pcovariance"
    cases: [ { name: "population" in: [ [1 2 3 4 5] [2 4 5 4 5] ] out: 1.2 } ]
    subs: []
  }

]


# --- run every spec ------------------------------------------------

def _ (specs each [
  var [[s]
    s Test.run-spec end
    0
  ]
])


# --- summary -------------------------------------------------------

# One `print (value)` per statement: `print` collects a FORWARD argument
# and a line break is not a barrier, so the older `"---" print` /
# `"x" print` chain printed out of order on boru main.
print ("---")
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print ("all green")
