# stats: descriptive, inferential, and matrix statistics in boru.
#
# Public surface (the Stats namespace exported at the bottom). Every
# query word accepts EITHER a List of numbers OR a Summary, except the
# order-statistic words (median/quantile/iqr/mode) which need the raw
# data and so take a List only.
#
#   --- accumulator (a streaming, mergeable Summary) ---
#   Stats.summary xs            → Summary   (build from a List; [] ⇒ empty)
#   Stats.push x s              → Summary   (value x into accumulator s; mutated in place)
#   Stats.push-all xs s         → Summary   (List xs into accumulator s; mutated in place)
#   Stats.merge b a             → Summary   (b's moments folded into a; a mutated)
#   Stats.encode s              → String    (jsonic snapshot)
#   Stats.decode text           → Summary   (rebuilt snapshot)
#
#   --- descriptive (List | Summary) ---
#   Stats.count x               → Integer
#   Stats.sum x                 → Float
#   Stats.mean x                → Float
#   Stats.variance x            → Float   (sample, n-1)
#   Stats.pvariance x           → Float   (population, n)
#   Stats.stddev x              → Float   (sample)
#   Stats.pstddev x             → Float   (population)
#   Stats.min x / max x / range x → Float
#   Stats.skewness x            → Float   (biased g1)
#   Stats.kurtosis x            → Float   (biased excess, g2)
#
#   --- order statistics (List only) ---
#   Stats.median xs             → Float
#   Stats.quantile xs q         → Float   (q in [0,1], linear interpolation)
#   Stats.iqr xs                → Float   (Q3 - Q1)
#   Stats.mode xs               → Float   (most frequent; first on ties)
#
#   --- bivariate (two Lists) ---
#   Stats.covariance xs ys      → Float   (sample)
#   Stats.pcovariance xs ys     → Float   (population)
#   Stats.correlation xs ys     → Float   (Pearson r)
#   Stats.linreg xs ys          → Map     ({slope, intercept, r, r2})
#
#   --- distributions / scores ---
#   Stats.zscores xs            → List    (sample-standardised)
#   Stats.normal-pdf x {mu,sigma} → Float
#   Stats.normal-cdf x {mu,sigma} → Float
#
#   --- matrix / dataset (rows = observations, cols = variables) ---
#   Stats.col-means mat         → List
#   Stats.col-variances mat     → List   (sample)
#   Stats.col-stddevs mat       → List   (sample)
#   Stats.cov-matrix mat        → Matrix (sample covariance)
#   Stats.cor-matrix mat        → Matrix (correlation)
#   Stats.standardize mat       → Matrix (z-scored columns)
#   Stats.ols x ys              → List   (least-squares coefficients)
#
# Failures raise coded errors (catch with `do […] error […]`, read
# `e.code` / `e.message` in the handler):
#
#   bad_input    empty data, too few points for the statistic, a
#                quantile out of [0,1], a non-positive sigma, or
#                mismatched vector lengths
#   needs_data   an order-statistic word (median/quantile/iqr/mode) or
#                zscores called on a Summary
#   singular     Stats.ols normal equations have no unique solution
#   bad_payload  Stats.decode text is not a Stats.encode snapshot
#
# Summary is a sealed `class` of running moments (Welford / Pébay), so
# mean/variance/skewness/kurtosis are computed in one pass and two
# Summaries merge in O(1). All arithmetic is done in Float — boru Integer
# overflow is a hard error, not a silent wrap, so sums of squares are
# floated up front.
#
# Calling convention: calls are written verb-first (the all-forward
# form) — the verb, then the data, then any extra arguments, terminated
# with `end` (or wrapped in parens): `Stats.mean xs end`,
# `Stats.covariance xs ys end`. Without a terminator the verb can swallow
# whatever token follows it, so close every call with `end` or parens.
# (The core array words `each`/`fold`, indexing `get`, and the matrix
# accessors `MatrixUtil.row`/`col` read their subject from the stack and
# stay subject-first — that is their native form.)
#
# Imported via `import "./stats.aql"` (a relative import resolves against
# the IMPORTING file's own directory); the importing script need not
# pre-import the `boru:*` utilities (math-util, array-util, matrix-util,
# struct-util) — this module imports them itself.


import "boru:math-util"
import "boru:array-util"
import "boru:matrix-util"
import "boru:struct-util"


# --- type -----------------------------------------------------------
#
# A Summary holds the running moments of a stream: count, mean, and the
# central-moment sums m2, m3, m4 (Σ(x-mean)^k), plus the running min and
# max. Variance/skewness/kurtosis are derived from these on demand. An
# empty Summary has n = 0; min/max are seeded by the first observation.

def Summary class {
  n:    0
  mean: 0.0
  m2:   0.0
  m3:   0.0
  m4:   0.0
  min:  0.0
  max:  0.0
}


# --- numeric helpers ------------------------------------------------

# Map any List of Numbers to a List of Floats (a no-op on Floats).
def to-floats fn [
  [xs:List] [List] [
    xs each [var [[x] (convert Float x)]]
  ]
]

def sum-floats fn [
  [xs:List] [Float] [
    0.0 xs [var [[x acc] acc add (convert Float x)]] fold
  ]
]

# Ascending sort of a Float list via grade (sort indices) + at (gather).
def sorted-floats fn [
  [xs:List] [List] [
    def fs (to-floats xs)
    ArrayUtil.at (ArrayUtil.grade fs) fs
  ]
]


# --- Welford / Pébay online moment update ---------------------------
#
# Add one Float observation to a Summary, mutating it in place and
# returning the same object. The higher-moment terms (m3, m4) use the
# old m2/m3 and the old mean, so every update term is bound with `def`
# from the pre-update fields before any `set` runs. `set` is written in
# its all-forward form: `set <field> <value> <container>`.

def welford-push fn [
  [s:Summary v:Float] [Summary] [
    def n0  s.n
    def n1  (n0 add 1)
    def nf  (convert Float n1)
    def delta (v sub s.mean)
    def dn  (delta div nf)
    def dn2 (dn mul dn)
    def t1  (delta mul dn mul (convert Float n0))
    def mean1 (s.mean add dn)
    def m2b (s.m2 add t1)
    def m3b ((s.m3 add (t1 mul dn mul (nf sub 2.0))) sub (3.0 mul dn mul s.m2))
    def m4term (t1 mul dn2 mul (((nf mul nf) sub (3.0 mul nf)) add 3.0))
    def m4b (((s.m4 add m4term) add (6.0 mul dn2 mul s.m2)) sub (4.0 mul dn mul s.m3))
    set mean (mean1) s end
    set m2 (m2b) s end
    set m3 (m3b) s end
    set m4 (m4b) s end
    set n (n1) s end
    if (n0 eq 0) [
      set min (v) s end
      set max (v) s end
    ] [
      if (v lt s.min) [set min (v) s end] []
      if (v gt s.max) [set max (v) s end] []
    ]
    s
  ]
]

# Build a fresh Summary from a List of Numbers.
def build-summary fn [
  [xs:List] [Summary] [
    def s (make Summary {n: 0, mean: 0.0, m2: 0.0, m3: 0.0, m4: 0.0, min: 0.0, max: 0.0})
    s xs [var [[x acc] welford-push acc (convert Float x)]] fold
  ]
]

# Coerce a query argument (List or Summary) to a Summary. The union
# param plus the positive `is List` test lets the checker narrow the
# build-summary branch to List, so it type-checks cleanly whether the
# caller passes a List or an already-built Summary.
def as-summary fn [
  [x:(List tor Summary)] [Summary] [
    if (x is List) [build-summary x] [x]
  ]
]

# Guard: order-statistic / bivariate words need raw data, not a Summary.
def require-list fn [
  [x:Any] [List] [
    if (x is Summary) [
      def msg `Stats: this word needs the raw data (a List), not a Summary`
      raise needs_data msg
    ] []
    if ((x is List) not) [
      def msg `Stats: expected a List of numbers (got ${x})`
      raise bad_input msg
    ] []
    x
  ]
]

def require-n fn [
  [s:Summary need:Integer] [Summary] [
    if ((s.n gte need) not) [
      def msg `Stats: need at least ${need} value(s) (have ${s.n})`
      raise bad_input msg
    ] []
    s
  ]
]


# --- public accumulator words ---------------------------------------

# Receiver-last (the accumulator `s` is the LAST param) so the forward
# form `Stats.push value summary` and the piping form `summary Stats.push
# value` both bind; only receiver-first-all-forward would misbind.
def stat-push fn [
  [x:Any s:Summary] [Summary] [
    welford-push s (convert Float x)
  ]
]

def stat-push-all fn [
  [xs:List s:Summary] [Summary] [
    s xs [var [[x acc] welford-push acc (convert Float x)]] fold
  ]
]

# Parallel-combine the moments of b into a (Chan/Pébay), mutating a. The
# receiver/return `a` is the LAST param (receiver-last), so `Stats.merge b
# a` folds b into a and returns a.
def stat-merge fn [
  [b:Summary a:Summary] [Summary] [
    def na a.n
    def nb b.n
    if (nb eq 0) [a] [
    if (na eq 0) [
      set n (b.n) a end
      set mean (b.mean) a end
      set m2 (b.m2) a end
      set m3 (b.m3) a end
      set m4 (b.m4) a end
      set min (b.min) a end
      set max (b.max) a end
      a
    ] [
      def naf (convert Float na)
      def nbf (convert Float nb)
      def nt  (na add nb)
      def ntf (convert Float nt)
      def delta (b.mean sub a.mean)
      def d2 (delta mul delta)
      def d3 (d2 mul delta)
      def d4 (d2 mul d2)
      def mean1 (a.mean add (delta mul nbf div ntf))
      def m2t ((a.m2 add b.m2) add (d2 mul naf mul nbf div ntf))
      def m3t (((a.m3 add b.m3) add (d3 mul naf mul nbf mul (naf sub nbf) div (ntf mul ntf))) add (3.0 mul delta mul ((naf mul b.m2) sub (nbf mul a.m2)) div ntf))
      def m4core (d4 mul naf mul nbf mul (((naf mul naf) sub (naf mul nbf)) add (nbf mul nbf)) div (ntf mul ntf mul ntf))
      def m4cross (6.0 mul d2 mul (((naf mul naf) mul b.m2) add ((nbf mul nbf) mul a.m2)) div (ntf mul ntf))
      def m4lin (4.0 mul delta mul ((naf mul b.m3) sub (nbf mul a.m3)) div ntf)
      def m4t ((((a.m4 add b.m4) add m4core) add m4cross) add m4lin)
      set mean (mean1) a end
      set m2 (m2t) a end
      set m3 (m3t) a end
      set m4 (m4t) a end
      set n (nt) a end
      if (b.min lt a.min) [set min (b.min) a end] []
      if (b.max gt a.max) [set max (b.max) a end] []
      a
    ]]
  ]
]


# --- descriptive words (List | Summary) -----------------------------

def stat-count fn [
  [x:(List tor Summary)] [Integer] [
    (as-summary x).n
  ]
]

def stat-sum fn [
  [x:(List tor Summary)] [Float] [
    def s (as-summary x)
    s.mean mul (convert Float s.n)
  ]
]

def stat-mean fn [
  [x:(List tor Summary)] [Float] [
    def s (require-n (as-summary x) 1)
    s.mean
  ]
]

def stat-pvariance fn [
  [x:(List tor Summary)] [Float] [
    def s (require-n (as-summary x) 1)
    s.m2 div (convert Float s.n)
  ]
]

def stat-variance fn [
  [x:(List tor Summary)] [Float] [
    def s (require-n (as-summary x) 2)
    s.m2 div (convert Float (s.n sub 1))
  ]
]

def stat-pstddev fn [
  [x:(List tor Summary)] [Float] [
    MathUtil.sqrt (stat-pvariance x)
  ]
]

def stat-stddev fn [
  [x:(List tor Summary)] [Float] [
    MathUtil.sqrt (stat-variance x)
  ]
]

def stat-min fn [
  [x:(List tor Summary)] [Float] [
    def s (require-n (as-summary x) 1)
    s.min
  ]
]

def stat-max fn [
  [x:(List tor Summary)] [Float] [
    def s (require-n (as-summary x) 1)
    s.max
  ]
]

def stat-range fn [
  [x:(List tor Summary)] [Float] [
    def s (require-n (as-summary x) 1)
    s.max sub s.min
  ]
]

# Biased sample skewness g1 = (m3/n) / (m2/n)^(3/2).
def stat-skewness fn [
  [x:(List tor Summary)] [Float] [
    def s (require-n (as-summary x) 2)
    def nf (convert Float s.n)
    def var-p (s.m2 div nf)
    if (var-p lte 0.0) [
      def msg `Stats.skewness: undefined for zero-variance data`
      raise bad_input msg
    ] []
    (s.m3 div nf) div ((MathUtil.sqrt var-p) mul var-p)
  ]
]

# Biased excess kurtosis g2 = (m4/n) / (m2/n)^2 - 3.
def stat-kurtosis fn [
  [x:(List tor Summary)] [Float] [
    def s (require-n (as-summary x) 2)
    def nf (convert Float s.n)
    def var-p (s.m2 div nf)
    if (var-p lte 0.0) [
      def msg `Stats.kurtosis: undefined for zero-variance data`
      raise bad_input msg
    ] []
    ((s.m4 div nf) div (var-p mul var-p)) sub 3.0
  ]
]


# --- order statistics (List only) -----------------------------------

# Linear-interpolated quantile (NumPy/R type-7) over sorted data.
def quantile-of fn [
  [fs:List q:Float] [Float] [
    def n (fs size)
    if (n eq 0) [
      def msg `Stats.quantile: empty data`
      raise bad_input msg
    ] []
    if ((q gte 0.0) and (q lte 1.0)) [] [
      def msg `Stats.quantile: q must be in [0, 1] (got ${q})`
      raise bad_input msg
    ]
    def sorted (sorted-floats fs)
    if (n eq 1) [sorted get 0] [
      def pos (q mul (convert Float (n sub 1)))
      def lo (MathUtil.floor pos)
      def hi (MathUtil.ceil pos)
      def frac (pos sub (convert Float lo))
      def vlo (sorted get (lo))
      def vhi (sorted get (hi))
      vlo add (frac mul (vhi sub vlo))
    ]
  ]
]

def stat-quantile fn [
  [xs:Any q:Any] [Float] [
    quantile-of (require-list xs) (convert Float q)
  ]
]

def stat-median fn [
  [xs:Any] [Float] [
    quantile-of (require-list xs) 0.5
  ]
]

def stat-iqr fn [
  [xs:Any] [Float] [
    def fs (require-list xs)
    (quantile-of fs 0.75) sub (quantile-of fs 0.25)
  ]
]

# Most frequent value; on a tie the first such value in ascending order.
def stat-mode fn [
  [xs:Any] [Float] [
    def fs (sorted-floats (require-list xs))
    if ((fs size) eq 0) [
      def msg `Stats.mode: empty data`
      raise bad_input msg
    ] []
    # Map values auto-evaluate, so the state maps are plain literals with
    # parenthesised computed values. (The older `do {k: [expr]}` spelling
    # also works for a value, but inside this fold body it trips a boru
    # runtime defect: after `def st1 (do {cur: [v]})` in an `each`/`fold`
    # var body inside a fn, the var-bound `v` reads `undefined word: v` —
    # works around that defect; the plain-literal form is the idiomatic
    # spelling anyway.)
    def seed {best: (fs get 0), best-count: 1, cur: (fs get 0), cur-count: 0}
    def acc (seed fs [var [[v st]
      def same (v eq (st.cur))
      def cc (if same [(st.cur-count) add 1] [1])
      def st1 {best: (st.best), best-count: (st.best-count), cur: v, cur-count: cc}
      # Both candidate states are bound before the `if` and the arms only
      # name them — works around boru compile defect: "a branch arm leaves
      # a list or map literal the interpreter keeps pending past the `if`
      # (NUR356)" — remove when fixed upstream.
      def won {best: v, best-count: cc, cur: v, cur-count: cc}
      if (cc gt (st1.best-count)) [won] [st1]
    ]] fold)
    acc.best
  ]
]


# --- bivariate (two Lists) ------------------------------------------

# Σ(x-mx)(y-my) over paired data, with the means computed in-pass.
def co-moment fn [
  [xs:List ys:List] [Float] [
    def fx (to-floats xs)
    def fy (to-floats ys)
    def n (fx size)
    if (n eq (fy size)) [] [
      def msg `Stats: paired data must be the same length (${n} vs ${fy size})`
      raise bad_input msg
    ]
    if (n gte 1) [] [
      def msg `Stats: paired data must be non-empty`
      raise bad_input msg
    ]
    def mx ((sum-floats fx) div (convert Float n))
    def my ((sum-floats fy) div (convert Float n))
    0.0 (iota n) [var [[i acc]
      acc add (((fx get (i)) sub mx) mul ((fy get (i)) sub my))
    ]] fold
  ]
]

def stat-pcovariance fn [
  [xs:List ys:List] [Float] [
    (co-moment xs ys) div (convert Float (xs size))
  ]
]

def stat-covariance fn [
  [xs:List ys:List] [Float] [
    def n (xs size)
    if (n gte 2) [] [
      def msg `Stats.covariance: need at least 2 paired values`
      raise bad_input msg
    ]
    (co-moment xs ys) div (convert Float (n sub 1))
  ]
]

def stat-correlation fn [
  [xs:List ys:List] [Float] [
    def sx (stat-pstddev xs)
    def sy (stat-pstddev ys)
    if ((sx gt 0.0) and (sy gt 0.0)) [] [
      def msg `Stats.correlation: undefined when a variable has zero variance`
      raise bad_input msg
    ]
    def n (xs size)
    def cov-p ((co-moment xs ys) div (convert Float n))
    cov-p div (sx mul sy)
  ]
]

# Ordinary least squares for one predictor: y ≈ slope*x + intercept.
def stat-linreg fn [
  [xs:List ys:List] [Map] [
    def n (xs size)
    if (n gte 2) [] [
      def msg `Stats.linreg: need at least 2 paired values`
      raise bad_input msg
    ]
    def fx (to-floats xs)
    def fy (to-floats ys)
    def mx ((sum-floats fx) div (convert Float n))
    def my ((sum-floats fy) div (convert Float n))
    def sxx (0.0 (iota n) [var [[i acc] acc add (((fx get (i)) sub mx) mul ((fx get (i)) sub mx))]] fold)
    if (sxx gt 0.0) [] [
      def msg `Stats.linreg: predictor has zero variance`
      raise bad_input msg
    ]
    def sxy (0.0 (iota n) [var [[i acc] acc add (((fx get (i)) sub mx) mul ((fy get (i)) sub my))]] fold)
    def syy (0.0 (iota n) [var [[i acc] acc add (((fy get (i)) sub my) mul ((fy get (i)) sub my))]] fold)
    def slope (sxy div sxx)
    def intercept (my sub (slope mul mx))
    def r (if (syy gt 0.0) [sxy div (MathUtil.sqrt (sxx mul syy))] [0.0])
    # A plain map literal (values auto-evaluate). Not `do {k: [expr]}`:
    # works around a boru runtime defect where a fn-local def read inside
    # a `do {…}` map leaves that name unresolvable as a var-bound name in a
    # LATER fn's `each`/`fold` body (this word's `r` broke solve-linear's
    # pivot fold `[var [[r best] …]]`: `undefined word: r`).
    {slope: slope, intercept: intercept, r: r, r2: (r mul r)}
  ]
]


# --- distributions / scores -----------------------------------------

def stat-zscores fn [
  [xs:Any] [List] [
    def fs (require-list xs)
    def mu (stat-mean fs)
    def sd (stat-stddev fs)
    if (sd gt 0.0) [] [
      def msg `Stats.zscores: zero standard deviation`
      raise bad_input msg
    ]
    fs each [var [[x] ((x sub mu) div sd)]]
  ]
]

# erf via Abramowitz & Stegun 7.1.26 (max abs error ≈ 1.5e-7).
def erf-approx fn [
  [x:Float] [Float] [
    def sgn (if (x lt 0.0) [-1.0] [1.0])
    def ax (convert Float (MathUtil.abs x))
    def t (1.0 div (1.0 add (0.3275911 mul ax)))
    def poly (t mul (0.254829592 add (t mul (-0.284496736 add (t mul (1.421413741 add (t mul (-1.453152027 add (t mul 1.061405429)))))))))
    def y (1.0 sub (poly mul (MathUtil.exp (MathUtil.negate (ax mul ax)))))
    sgn mul y
  ]
]

def sigma-of fn [
  [params:Map] [Float] [
    def sigma (convert Float (params.sigma))
    if (sigma gt 0.0) [] [
      def msg `Stats: sigma must be > 0 (got ${sigma})`
      raise bad_input msg
    ]
    sigma
  ]
]

def stat-normal-pdf fn [
  [x:Any params:Map] [Float] [
    def mu (convert Float (params.mu))
    def sigma (sigma-of params)
    def z (((convert Float x) sub mu) div sigma)
    def norm (1.0 div (sigma mul (MathUtil.sqrt (2.0 mul MathUtil.pi))))
    norm mul (MathUtil.exp (-0.5 mul z mul z))
  ]
]

def stat-normal-cdf fn [
  [x:Any params:Map] [Float] [
    def mu (convert Float (params.mu))
    def sigma (sigma-of params)
    def z (((convert Float x) sub mu) div sigma)
    0.5 mul (1.0 add (erf-approx (z div (MathUtil.sqrt 2.0))))
  ]
]


# --- matrix / dataset (rows = observations, cols = variables) -------

# Each column of the matrix, as a List of Lists.
def columns-of fn [
  [mat:MatrixUtil.Matrix] [List] [
    def k (MatrixUtil.cols mat)
    (iota k) each [var [[j] (mat MatrixUtil.col j)]]
  ]
]

def stat-col-means fn [
  [mat:MatrixUtil.Matrix] [List] [
    (columns-of mat) each [var [[c] (stat-mean c)]]
  ]
]

def stat-col-variances fn [
  [mat:MatrixUtil.Matrix] [List] [
    (columns-of mat) each [var [[c] (stat-variance c)]]
  ]
]

def stat-col-stddevs fn [
  [mat:MatrixUtil.Matrix] [List] [
    (columns-of mat) each [var [[c] (stat-stddev c)]]
  ]
]

# Sample covariance matrix: (1/(n-1)) Xcᵀ Xc, Xc the column-centered data.
def centered-rows fn [
  [mat:MatrixUtil.Matrix] [List] [
    def means (stat-col-means mat)
    def nrows (MatrixUtil.rows mat)
    def ncols (MatrixUtil.cols mat)
    (iota nrows) each [var [[i]
      def row (mat MatrixUtil.row i)
      (iota ncols) each [var [[j]
        ((row get (j)) sub (means get (j)))
      ]]
    ]]
  ]
]

def stat-cov-matrix fn [
  [mat:MatrixUtil.Matrix] [MatrixUtil.Matrix] [
    def nrows (MatrixUtil.rows mat)
    if (nrows gte 2) [] [
      def msg `Stats.cov-matrix: need at least 2 rows (observations)`
      raise bad_input msg
    ]
    def xc (MatrixUtil.create (centered-rows mat))
    # mat-mul X Y computes Y@X, so this is Xcᵀ @ Xc.
    def gram (MatrixUtil.mat-mul xc (MatrixUtil.transpose xc))
    MatrixUtil.scale (1.0 div (convert Float (nrows sub 1))) gram
  ]
]

def stat-cor-matrix fn [
  [mat:MatrixUtil.Matrix] [MatrixUtil.Matrix] [
    def cov (stat-cov-matrix mat)
    def k (MatrixUtil.cols cov)
    def sds ((iota k) each [var [[i] (MathUtil.sqrt ((cov MatrixUtil.row i) get (i)))]])
    MatrixUtil.create ((iota k) each [var [[i]
      def crow (cov MatrixUtil.row i)
      (iota k) each [var [[j]
        ((crow get (j)) div ((sds get (i)) mul (sds get (j))))
      ]]
    ]])
  ]
]

def stat-standardize fn [
  [mat:MatrixUtil.Matrix] [MatrixUtil.Matrix] [
    def means (stat-col-means mat)
    def sds (stat-col-stddevs mat)
    def nrows (MatrixUtil.rows mat)
    def ncols (MatrixUtil.cols mat)
    MatrixUtil.create ((iota nrows) each [var [[i]
      def row (mat MatrixUtil.row i)
      (iota ncols) each [var [[j]
        ((row get (j)) sub (means get (j)) div (sds get (j)))
      ]]
    ]])
  ]
]


# --- linear solver + OLS --------------------------------------------
#
# Solve a square system A x = b by Gaussian elimination with partial
# pivoting. A is a List of equal-length rows (Lists); b is a List. Rows
# are copied into mutable FlexLists so pivoting and elimination run in
# place. A zero pivot (within tolerance) raises `singular`.

def solve-linear fn [
  [a:List b:List] [List] [
    def n (a size)
    def rows (flex ((iota n) each [var [[i]
      flex ((a get (i)) each [var [[v] (convert Float v)]])
    ]]))
    def rhs (flex (b each [var [[v] (convert Float v)]]))
    def _elim ((iota n) each [var [[col]
      # find pivot row with the largest |value| in this column
      def piv (col (iota n) [var [[r best]
        if ((r gte col) and ((MathUtil.abs ((rows get (r)) get (col))) gt (MathUtil.abs ((rows get (best)) get (col))))) [r] [best]
      ]] fold)
      def pv (MathUtil.abs ((rows get (piv)) get (col)))
      if (pv gt 0.000000001) [] [
        def msg `Stats.ols: system is singular (zero pivot at column ${col})`
        raise singular msg
      ]
      # swap pivot row into place (rows and rhs)
      def tmp-row (rows get (col))
      set (col) (rows get (piv)) rows end drop
      set (piv) (tmp-row) rows end drop
      def tmp-rhs (rhs get (col))
      set (col) (rhs get (piv)) rhs end drop
      set (piv) (tmp-rhs) rhs end drop
      # eliminate below
      def pivrow (rows get (col))
      def pivval (pivrow get (col))
      def _r ((iota n) each [var [[r]
        if (r gt col) [
          def rr (rows get (r))
          def factor ((rr get (col)) div pivval)
          def _c ((iota n) each [var [[c]
            set (c) ((rr get (c)) sub (factor mul (pivrow get (c)))) rr end drop
            0
          ]])
          set (r) ((rhs get (r)) sub (factor mul (rhs get (col)))) rhs end drop
          0
        ] [0]
      ]])
      0
    ]])
    # back-substitution into a mutable solution FlexList
    def x (flex ((iota n) each [var [[i] 0.0]]))
    def _back ((iota n) each [var [[step]
      def i (n sub 1 sub step)
      def rr (rows get (i))
      def s (0.0 (iota n) [var [[j acc]
        if (j gt i) [acc add ((rr get (j)) mul (x get (j)))] [acc]
      ]] fold)
      set (i) (((rhs get (i)) sub s) div (rr get (i))) x end drop
      0
    ]])
    node x
  ]
]

# OLS coefficients for design matrix x (rows = observations, cols =
# predictors) and response ys, via the normal equations XᵀX b = Xᵀy.
# Prepend a column of 1s to x yourself for an intercept term.
def stat-ols fn [
  [x:MatrixUtil.Matrix ys:List] [List] [
    def nrows (MatrixUtil.rows x)
    if (nrows eq (ys size)) [] [
      def msg `Stats.ols: rows of X (${nrows}) must match length of y (${ys size})`
      raise bad_input msg
    ]
    # mat-mul X Y computes Y@X, so this is Xᵀ @ X.
    def xtx (MatrixUtil.mat-mul x (MatrixUtil.transpose x))
    def k (MatrixUtil.cols x)
    def fy (to-floats ys)
    def xty ((iota k) each [var [[j] (MatrixUtil.dot (x MatrixUtil.col j) fy)]])
    def arows ((iota k) each [var [[i] xtx MatrixUtil.row i]])
    solve-linear arows xty
  ]
]


# --- encode / decode ------------------------------------------------
#
# Snapshot a Summary as a jsonic String (every moment field) and rebuild
# it. Reads on decode are strict; any malformation re-raises as one
# bad_payload error.

def stat-encode fn [
  [s:Summary] [String] [
    def payload {
      n:    (s.n)
      mean: (s.mean)
      m2:   (s.m2)
      m3:   (s.m3)
      m4:   (s.m4)
      min:  (s.min)
      max:  (s.max)
    }
    `${payload}`
  ]
]

def stat-decode fn [
  [text:String] [Summary] [
    def payload (do [StructUtil.parse text] error [
      def msg `Stats.decode: payload is not parseable jsonic`
      raise bad_payload msg
    ])
    do [
      # With the StructUtil.parse float-fidelity fix, whole-valued Float
      # moments round-trip as Float (e.g. `8.0`, not `8`), so the moments
      # no longer need per-field coercion; n is read as the integer count
      # it was encoded as.
      make Summary {
        n:    (convert Integer (payload !. n))
        mean: (payload !. mean)
        m2:   (payload !. m2)
        m3:   (payload !. m3)
        m4:   (payload !. m4)
        min:  (payload !. min)
        max:  (payload !. max)
      }
    ] error [
      def msg `Stats.decode: payload is not a Stats.encode snapshot (need integer n, floats mean m2 m3 m4 min max)`
      raise bad_payload msg
    ]
  ]
]


# --- namespace ------------------------------------------------------
#
# Functions are exported with `/v` (the binding's VALUE, not a call) so
# the auto-evaluating map literal doesn't dispatch them at construction
# time. The Summary type goes in bare.

export "Stats" {
  Summary
  summary:      build-summary/v
  push:         stat-push/v
  push-all:     stat-push-all/v
  merge:        stat-merge/v
  encode:       stat-encode/v
  decode:       stat-decode/v

  count:        stat-count/v
  sum:          stat-sum/v
  mean:         stat-mean/v
  variance:     stat-variance/v
  pvariance:    stat-pvariance/v
  stddev:       stat-stddev/v
  pstddev:      stat-pstddev/v
  min:          stat-min/v
  max:          stat-max/v
  range:        stat-range/v
  skewness:     stat-skewness/v
  kurtosis:     stat-kurtosis/v

  median:       stat-median/v
  quantile:     stat-quantile/v
  iqr:          stat-iqr/v
  mode:         stat-mode/v

  covariance:   stat-covariance/v
  pcovariance:  stat-pcovariance/v
  correlation:  stat-correlation/v
  linreg:       stat-linreg/v

  zscores:      stat-zscores/v
  normal-pdf:   stat-normal-pdf/v
  normal-cdf:   stat-normal-cdf/v

  col-means:    stat-col-means/v
  col-variances: stat-col-variances/v
  col-stddevs:  stat-col-stddevs/v
  cov-matrix:   stat-cov-matrix/v
  cor-matrix:   stat-cor-matrix/v
  standardize:  stat-standardize/v
  ols:          stat-ols/v
}
